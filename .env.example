# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=irtran
MYSQL_USER=irtran
MYSQL_PASSWORD=irtran

# Keycloak
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost/auth/realms/master

# Spring AI provider (server-side only)
AI_ENABLED=true
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Обычно пусто: браузер обращается к nginx на текущем origin.
VITE_API_URL=
VITE_AI_API_URL=
